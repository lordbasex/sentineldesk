# TLS_MODE=selfsigned — a self-signed certificate from Caddy's internal CA.
# It needs neither a domain nor DNS: it serves https://<IP or name> with the
# browser's "not trusted" warning, or install the CA from /data/caddy/pki.
{$DOMAIN:localhost} {
	tls internal
	reverse_proxy 127.0.0.1:8080
}
