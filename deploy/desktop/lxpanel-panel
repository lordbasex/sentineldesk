# Panel superior — receta Berry (estilo Raspberry Pi OS)
#
# Every `image=` here is an icon NAME, not a path, and that is deliberate.
#
# It used to be absolute — /usr/share/icons/Papirus/24x24/apps/<name>.svg —
# which looks more precise and is in fact more brittle in every direction. A
# path names one file in one theme at one size; when that file is not exactly
# there the item simply draws nothing, with no warning anywhere, which is the
# hardest kind of breakage to attribute. It had already happened: Papirus keeps
# network-vpn.svg under `devices`, not `apps`, so the VPN entry had been
# iconless since it was added, in the container and on the host alike.
#
# A name goes through the icon theme instead, which is what the theme is for:
# it searches every category and size, and falls back down the inheritance
# chain (Papirus → hicolor → Adwaita) when Papirus does not have it. So an icon
# that moved between releases still resolves, a machine whose Papirus failed to
# install keeps the freedesktop names that every theme carries, and only a name
# no installed theme has at all comes up empty.
#
# Same principle as everything else here: degrade, do not blank out.
Global {
  edge=top
  align=left
  margin=0
  widthtype=percent
  width=100
  height=36
  transparent=0
  tintcolor=#edeceb
  alpha=255
  autohide=0
  setdocktype=1
  setpartialstrut=1
  usefontcolor=1
  fontcolor=#1d1d1d
  background=0
  backgroundfile=
  iconsize=28
}
Plugin {
  type=space
  Config {
    Size=4
  }
}
Plugin {
  type=menu
  Config {
    image=applications-all
    # Grouped by what somebody wants to do, not by which package ships it.
    #
    # The four at the top are what gets opened every session and they stay one
    # click away; everything else is one level down, so the menu is a short list
    # rather than a wall. One language throughout — it used to mix Spanish and
    # English in the same column, which reads as an oversight to somebody who
    # speaks both.
    #
    # Every entry here is a command this image actually installs. The old menu
    # offered FileZilla, which was never in the package list: a menu that lies is
    # worse than a short one.
    item {
      name=Terminal
      image=utilities-terminal
      action=lxterminal
    }
    item {
      name=Web Browser
      image=chromium
      action=chromium
    }
    item {
      name=Files
      image=system-file-manager
      action=pcmanfm
    }
    item {
      name=Text Editor
      image=accessories-text-editor
      action=mousepad
    }
    separator {
    }
    menu {
      name=Accessories
      image=applications-accessories
      item {
        name=Image Viewer
        image=multimedia-photo-viewer
        action=gpicview
      }
      item {
        name=Document Viewer
        image=evince
        action=evince
      }
      item {
        name=Archive Manager
        image=xarchiver
        action=xarchiver
      }
      item {
        name=Calculator
        image=galculator
        action=galculator
      }
      item {
        name=Media Player
        image=vlc
        action=vlc
      }
    }
    menu {
      name=Network
      image=preferences-system-network
      item {
        name=Remote Desktop (RDP)
        image=remmina
        action=rdp-connect
      }
      item {
        name=Remote Desktop (VNC)
        image=krdc
        action=vnc-connect
      }
      item {
        name=VPN (OpenVPN)
        image=network-vpn
        action=openvpn-connect
      }
      separator {
      }
      item {
        name=SIP Capture (sngrep)
        image=utilities-terminal
        action=lxterminal -e sh -c "sudo -n sngrep || sngrep"
      }
      item {
        name=Port Scan (nmap)
        image=nmap
        action=lxterminal -e sentineldesk-hint nmap
      }
      item {
        name=Throughput Test (iperf3)
        image=utilities-system-monitor
        action=lxterminal -e sentineldesk-hint iperf3
      }
      item {
        name=Live Route (mtr)
        image=utilities-terminal
        action=lxterminal -e sentineldesk-hint mtr
      }
    }
    menu {
      name=System Tools
      image=applications-system
      item {
        name=Task Manager
        image=utilities-system-monitor
        action=lxtask
      }
      item {
        name=Process Viewer (htop)
        image=htop
        action=lxterminal -e htop
      }
      item {
        name=Disk Usage (ncdu)
        image=disk-usage-analyzer
        action=lxterminal -e ncdu /
      }
      item {
        name=Midnight Commander
        image=mc
        action=lxterminal -e mc
      }
    }
    menu {
      name=All Applications
      image=applications-other
      system {
      }
    }
    separator {
    }
    item {
      name=Run…
      image=system-run
      command=run
    }
  }
}
Plugin {
  type=space
  Config {
    Size=6
  }
}
Plugin {
  type=launchbar
  Config {
    Button {
      id=chromium.desktop
    }
    Button {
      id=pcmanfm.desktop
    }
    Button {
      id=lxterminal.desktop
    }
  }
}
Plugin {
  type=space
  Config {
    Size=8
  }
}
Plugin {
  type=taskbar
  expand=1
  Config {
    tooltips=1
    IconsOnly=0
    ShowAllDesks=0
    UseMouseWheel=1
    UseUrgencyHint=1
    FlatButton=1
    MaxTaskWidth=200
    spacing=2
  }
}
Plugin {
  type=tray
  Config {
  }
}
Plugin {
  type=cpu
  Config {
  }
}
Plugin {
  type=space
  Config {
    Size=6
  }
}
Plugin {
  type=dclock
  Config {
    ClockFmt=%H:%M
    TooltipFmt=%A %d %B %Y
    BoldFont=1
    IconOnly=0
    CenterText=1
  }
}
Plugin {
  type=space
  Config {
    Size=6
  }
}
