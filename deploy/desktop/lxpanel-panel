# Panel superior — receta Berry (estilo Raspberry Pi OS)
#
# Every icon here is an absolute PATH, and every launcher gives its own image
# and command rather than naming a .desktop file. Both are deliberate, both are
# the opposite of what a freedesktop purist would write, and the reason is a
# Raspberry Pi.
#
# The tidy version of this file used icon NAMES and let the theme resolve them:
# it searches every category and size and falls back Papirus → hicolor → Adwaita,
# so an icon that moves between releases still draws. That is correct on Debian,
# where it was written and photographed working.
#
# Raspberry Pi OS ships its own libfm-gtk3 and GTK (1.4.0-2+rpt8, 3.24.49-3+rpt8),
# and on that combination lxpanel resolves a themed icon through a code path that
# ends in
#
#   gtk_icon_theme_choose_icon_for_scale: assertion 'scale >= 1' failed
#   gtk_icon_theme_load_icon_for_scale:   assertion 'scale >= 1' failed
#
# — a scale of zero, GTK refusing, the lookup returning NULL and lxpanel drawing
# `image-missing` instead. Which in Papirus is a circle with a line through it.
# So the panel comes up as a row of ⊘, on the platform this project puts on its
# front page. Photographed on a real Pi 5: launcher buttons ⊘, and the same
# panel with the menu switched to names ⊘ all the way down its menu too.
#
# An absolute path never enters that code path. It is loaded as a file, which is
# why the menu kept working on that Pi while the launchers beside it did not.
#
# The cost is that a path is exact: when Papirus moves a file, that one entry
# goes silently blank. That already happened — network-vpn.svg lives under
# `devices`, not `apps`, and the VPN entry had no icon from the day it was added
# until the installer learned to check. So the installer checks: see
# check_panel_icons() in install.sh, which compares every path in this file
# against what is on the machine and says which ones are not there. A silent
# hole is the thing to avoid; a path plus a check has no silent hole, and it
# works on the hardware people actually install this on.
Global {
  edge=top
  align=left
  margin=0
  widthtype=percent
  width=100
  height=36
  transparent=0
  tintcolor=#edeceb
  alpha=255
  autohide=0
  setdocktype=1
  setpartialstrut=1
  usefontcolor=1
  fontcolor=#1d1d1d
  background=0
  backgroundfile=
  iconsize=28
}
Plugin {
  type=space
  Config {
    Size=4
  }
}
Plugin {
  type=menu
  Config {
    image=/usr/share/icons/Papirus/24x24/apps/applications-all.svg
    # Grouped by what somebody wants to do, not by which package ships it.
    #
    # The four at the top are what gets opened every session and they stay one
    # click away; everything else is one level down, so the menu is a short list
    # rather than a wall. One language throughout — it used to mix Spanish and
    # English in the same column, which reads as an oversight to somebody who
    # speaks both.
    #
    # Every entry here is a command this image actually installs. The old menu
    # offered FileZilla, which was never in the package list: a menu that lies is
    # worse than a short one.
    item {
      name=Terminal
      image=/usr/share/icons/Papirus/24x24/apps/utilities-terminal.svg
      action=lxterminal
    }
    item {
      name=Web Browser
      image=/usr/share/icons/Papirus/24x24/apps/chromium.svg
      action=chromium
    }
    item {
      name=Files
      image=/usr/share/icons/Papirus/24x24/apps/system-file-manager.svg
      action=pcmanfm
    }
    item {
      name=Text Editor
      image=/usr/share/icons/Papirus/24x24/apps/accessories-text-editor.svg
      action=mousepad
    }
    separator {
    }
    menu {
      name=Accessories
      image=/usr/share/icons/Papirus/24x24/apps/applications-accessories.svg
      item {
        name=Image Viewer
        image=/usr/share/icons/Papirus/24x24/apps/multimedia-photo-viewer.svg
        action=gpicview
      }
      item {
        name=Document Viewer
        image=/usr/share/icons/Papirus/24x24/apps/evince.svg
        action=evince
      }
      item {
        name=Archive Manager
        image=/usr/share/icons/Papirus/24x24/apps/xarchiver.svg
        action=xarchiver
      }
      item {
        name=Calculator
        image=/usr/share/icons/Papirus/24x24/apps/galculator.svg
        action=galculator
      }
      item {
        name=Media Player
        image=/usr/share/icons/Papirus/24x24/apps/vlc.svg
        action=vlc
      }
    }
    menu {
      name=Network
      image=/usr/share/icons/Papirus/24x24/apps/preferences-system-network.svg
      item {
        name=Remote Desktop (RDP)
        image=/usr/share/icons/Papirus/24x24/apps/remmina.svg
        action=rdp-connect
      }
      item {
        name=Remote Desktop (VNC)
        image=/usr/share/icons/Papirus/24x24/apps/krdc.svg
        action=vnc-connect
      }
      item {
        name=VPN (OpenVPN)
        image=/usr/share/icons/Papirus/24x24/devices/network-vpn.svg
        action=openvpn-connect
      }
      separator {
      }
      item {
        name=SIP Capture (sngrep)
        image=/usr/share/icons/Papirus/24x24/apps/utilities-terminal.svg
        action=lxterminal -e sh -c "sudo -n sngrep || sngrep"
      }
      item {
        name=Port Scan (nmap)
        image=/usr/share/icons/Papirus/24x24/apps/nmap.svg
        action=lxterminal -e sentineldesk-hint nmap
      }
      item {
        name=Throughput Test (iperf3)
        image=/usr/share/icons/Papirus/24x24/apps/utilities-system-monitor.svg
        action=lxterminal -e sentineldesk-hint iperf3
      }
      item {
        name=Live Route (mtr)
        image=/usr/share/icons/Papirus/24x24/apps/utilities-terminal.svg
        action=lxterminal -e sentineldesk-hint mtr
      }
    }
    menu {
      name=System Tools
      image=/usr/share/icons/Papirus/24x24/apps/applications-system.svg
      item {
        name=Task Manager
        image=/usr/share/icons/Papirus/24x24/apps/utilities-system-monitor.svg
        action=lxtask
      }
      item {
        name=Process Viewer (htop)
        image=/usr/share/icons/Papirus/24x24/apps/htop.svg
        action=lxterminal -e htop
      }
      item {
        name=Disk Usage (ncdu)
        image=/usr/share/icons/Papirus/24x24/apps/disk-usage-analyzer.svg
        action=lxterminal -e ncdu /
      }
      item {
        name=Midnight Commander
        image=/usr/share/icons/Papirus/24x24/apps/mc.svg
        action=lxterminal -e mc
      }
    }
    menu {
      name=All Applications
      image=/usr/share/icons/Papirus/24x24/apps/applications-other.svg
      system {
      }
    }
    separator {
    }
    item {
      name=Run…
      image=/usr/share/icons/Papirus/24x24/actions/system-run.svg
      command=run
    }
  }
}
Plugin {
  type=space
  Config {
    Size=6
  }
}
Plugin {
  type=launchbar
  Config {
    Button {
      image=/usr/share/icons/Papirus/24x24/apps/chromium.svg
      action=chromium
      tooltip=Web Browser
    }
    Button {
      image=/usr/share/icons/Papirus/24x24/apps/system-file-manager.svg
      action=pcmanfm
      tooltip=Files
    }
    Button {
      image=/usr/share/icons/Papirus/24x24/apps/utilities-terminal.svg
      action=lxterminal
      tooltip=Terminal
    }
  }
}
Plugin {
  type=space
  Config {
    Size=8
  }
}
Plugin {
  type=taskbar
  expand=1
  Config {
    tooltips=1
    IconsOnly=0
    ShowAllDesks=0
    UseMouseWheel=1
    UseUrgencyHint=1
    FlatButton=1
    MaxTaskWidth=200
    spacing=2
  }
}
Plugin {
  type=tray
  Config {
  }
}
Plugin {
  type=cpu
  Config {
  }
}
Plugin {
  type=space
  Config {
    Size=6
  }
}
Plugin {
  type=dclock
  Config {
    ClockFmt=%H:%M
    TooltipFmt=%A %d %B %Y
    BoldFont=1
    IconOnly=0
    CenterText=1
  }
}
Plugin {
  type=space
  Config {
    Size=6
  }
}
