#!/bin/sh
# Launches Steam where it is available (x86_64 only), passing arguments
# through (for example -bigpicture for Steam Deck / Big Picture mode).
# En Debian el binario vive en /usr/games.
PATH="$PATH:/usr/games:/usr/local/games"
if command -v steam >/dev/null 2>&1; then
    exec steam "$@"
fi
zenity --error --title="Steam" \
    --text="Steam is only available on x86_64 (amd64) images.\nThis image is $(uname -m)." 2>/dev/null
