# TLS_MODE=auto — Let's Encrypt, automatic (HTTP-01 / TLS-ALPN).
# Needs: DOMAIN pointing at this server and ports 80/443 open.
# ACME_EMAIL es opcional (avisos de vencimiento).
{$DOMAIN} {
	reverse_proxy 127.0.0.1:8080
}
