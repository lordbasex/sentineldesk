# TLS_MODE=custom — your own certificate: a purchased SSL wildcard, a corporate
# certificate, or one issued by another tool such as certbot.
# Copy the files into ./certs/ as fullchain.pem and privkey.pem.
{$DOMAIN} {
	tls /certs/fullchain.pem /certs/privkey.pem
	reverse_proxy 127.0.0.1:8080
}
